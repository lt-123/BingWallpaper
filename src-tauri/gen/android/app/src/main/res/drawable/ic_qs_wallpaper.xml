<?xml version="1.0" encoding="utf-8"?>
<!--
  Wallora QS Tile Icon — 24×24dp monochrome
  Design: landscape photo frame + sun + mountain silhouette
  All paths white on transparent; system applies tint automatically.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!--
      Photo frame border: outer rounded rect (2,3)→(22,21) minus inner rect (4,5)→(20,19).
      evenOdd fill rule cuts out the center, leaving only the 1-dp-wide border.
    -->
    <path
        android:fillColor="@android:color/white"
        android:fillType="evenOdd"
        android:pathData="
            M20,3H4C2.9,3,2,3.9,2,5v14c0,1.1,0.9,2,2,2h16c1.1,0,2,-0.9,2,-2V5C22,3.9,21.1,3,20,3z
            M20,19H4V5h16V19z"/>

    <!--
      Sun: circle centered at (16.5, 8.5), radius 2.
      Drawn as two back-to-back arcs from the leftmost point (14.5, 8.5).
    -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M14.5,8.5 a2,2 0 0 1 4,0 a2,2 0 0 1 -4,0z"/>

    <!--
      Mountain silhouette filling the lower third of the frame.
      Vertices: left edge → left peak (8,13.5) → valley (10.5,16.5)
               → right peak (13.5,11.5) → right edge (20,18.5) → bottom strip → close.
    -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M4,18.5 l4,-5 2.5,3 3,-5 6.5,7 V19 H4 Z"/>

</vector>
